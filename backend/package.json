{
  "name": "velocity-retail-backend",
  "version": "1.0.0",
  "description": "Backend for Velocity Retail - fast-mover product analytics & recommendation system",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "echo Backend in JavaScript - ready",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "sync:cloudinary": "node src/utils/syncCloudinary.js",
    "switch:typescript": "powershell -Command \"Remove-Item -Recurse -Force src; Copy-Item -Recurse src_ts src\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
